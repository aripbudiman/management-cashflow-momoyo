APP_NAME=Momoyo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_PORT=80
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=momoyo
DB_USERNAME=momoyo
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log

# MinIO (S3 compatible)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=momoyo
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=momoyo
# endpoint internal (antar container)
AWS_ENDPOINT=http://minio:9000
# URL publik untuk akses file dari browser
AWS_URL=http://localhost:9000/momoyo
AWS_USE_PATH_STYLE_ENDPOINT=true
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

VITE_APP_NAME="${APP_NAME}"
